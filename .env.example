# API server (Express). Generate a long random string for production.
JWT_SECRET=change-me-to-a-long-random-secret

# Port for the API (default 3001).
# PORT=3001

# Allowed browser origin for cookies + CORS (Vite dev server).
CORS_ORIGIN=http://localhost:5173

# When using `vite preview`, match its origin, e.g.:
# CORS_ORIGIN=http://localhost:4173
